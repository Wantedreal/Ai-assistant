# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit it.

# ── Corporate PC (Zscaler / restricted network) ───────────────────────────────
# Anthropic Claude — primary provider, tried first when this key is present.
# On corporate networks where Groq/OpenRouter are blocked, set this key.
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Home / personal PC (optional — keys embedded in code as fallback) ─────────
# Groq — free, fastest streaming (14 400 req/day)
GROQ_API_KEY=your_groq_key_here

# OpenRouter — free fallback chain
OPENROUTER_API_KEY=your_openrouter_key_here

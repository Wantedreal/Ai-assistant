# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit it.

# ── Corporate PC (Zscaler / restricted network) ───────────────────────────────
# Capgemini AI Gateway — primary provider, tried first when this key is present.
# Get your General API key from: https://api.generative.engine.capgemini.com/
# Model used: anthropic.claude-sonnet-4-6
CAPGEMINI_API_KEY=your_general_api_key_here

# ── Home / personal PC (optional — keys embedded in code as fallback) ─────────
# Groq — free, fastest streaming (14 400 req/day)
GROQ_API_KEY=your_groq_key_here

# OpenRouter — free fallback chain
OPENROUTER_API_KEY=your_openrouter_key_here

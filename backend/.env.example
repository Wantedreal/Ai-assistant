# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit it.
# Keys are also embedded in chat.py / explainer.py as fallback,
# so the app works without a .env file (useful on fresh machines).

# Groq — primary AI provider (free, fastest streaming)
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# OpenRouter — fallback AI provider (free tier)
# Get a free key at: https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_key_here
